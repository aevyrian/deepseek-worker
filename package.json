{
  "name": "deepseek-worker-connector",
  "version": "0.3.3-preview.6",
  "private": true,
  "description": "让 ChatGPT 连接并指挥本机 DeepSeek Harness 执行 Workspace 任务的 Connector。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aevyrian/deepseek-worker.git"
  },
  "homepage": "https://github.com/aevyrian/deepseek-worker#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "worker",
    "workspace",
    "mcp",
    "chatgpt"
  ],
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "dsh.bundle.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "install.ps1",
    "test-local.ps1",
    "tests/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-app-boot": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}
